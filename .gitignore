# nerima-lisp standard .gitignore
# Copy to <repo>/.gitignore and append repository-specific entries below the
# marked section. Everything above the marker must stay identical across repos
# so that "is this artifact ignored?" has the same answer everywhere.

# --- Common Lisp build output ---
*.fasl
*.fas
*.lib
*.dfsl
*.ufsl
*.fsl

# --- Nix ---
/result
/result-*
/.direnv/

# --- Test and coverage output ---
/coverage/
/coverage-report/
/*-coverage-report/
*.coverage
coverage.dat
/__snapshots__/
/*-snapshots/

# --- Local caches and scratch space ---
/.cache/
/.deps/
/tmp/
/.worktrees/
/.paredit.cleanup/

# --- Editor and OS noise ---
.DS_Store
*~
\#*\#
.\#*

# --- Repository-specific entries below this line ---

# `mkdocs build` writes here: docs/mkdocs.yml sets `site_dir: ../site`, which
# resolves to the repository root rather than under docs/.
/site/

# paredit-cli writes its backups next to the sources it rewrites, so they turn
# up under src/ and t/ as well as at the root the template already covers.
.paredit.cleanup/

# Scratch space for hand-run debugging sessions; the template only covers /tmp/.
/tmp-debug/

# Serena's language-server cache. .serena/project.yml is intentionally tracked.
.serena/cache/
